<odoo>
    <record id="group_equipment_user" model="res.groups">
        <field name="name">Equipment User</field>
    </record>

    <record id="group_equipment_manager" model="res.groups">
        <field name="name">Equipment Manager</field>

        <field name="implied_ids"
               eval="[(4, ref('porcelia_equipment_loan.group_equipment_user'))]"/>
    </record>

    <record id="equipment_loan_manager_rule" model="ir.rule">
        <field name="name">Equipment Loan Manager Rule</field>
        <field name="model_id" ref="model_equipment_loan"/>

        <field name="groups"
               eval="[(4, ref('porcelia_equipment_loan.group_equipment_manager'))]"/>

        <field name="domain_force">
            []
        </field>
    </record>
</odoo>