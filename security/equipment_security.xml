<odoo>
<record id="equipment_loan_user_rule"
        model="ir.rule">

    <field name="name">
        Equipment Loan User Rule
    </field>

    <field name="model_id"
           ref="model_equipment_loan"/>

    <field name="groups"
           eval="[(4, ref('porcelia_equipment_loan.group_equipment_user'))]"/>

    <field name="domain_force">
        [('borrower_id', '=', user.id)]
    </field>
</record>
</odoo>