<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="res_users_form_equipment_loan" model="ir.ui.view">
        <field name="name">res.users.form.equipment.loan</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>

        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">

                <page string="Equipment Loans">

                    <field name="equipment_loan_ids">

                        <tree decoration-danger="is_overdue">
                            <field name="name"/>
                            <field name="item_id"/>
                            <field name="date_start"/>
                            <field name="date_due"/>
                            <field name="date_return"/>
                            <field name="state"/>
                            <field name="days_late"/>
                            <field name="penalty_amount"/>
                            <field name="is_overdue" column_invisible="1"/>
                        </tree>

                    </field>

                </page>

            </xpath>

        </field>
    </record>

</odoo>