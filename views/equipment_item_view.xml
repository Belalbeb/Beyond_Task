<odoo>
    <record id="equipment_item_tree_view" model="ir.ui.view">
    <field name="name">equipment.item.tree</field>
    <field name="model">equipment.item</field>
    <field name="arch" type="xml">

        <tree>
            <field name="code"/>
            <field name="name"/>
            <field name="category_id"/>
            <field name="daily_rate"/>
            <field name="condition_score"/>
            <field name="state"/>
            <field name="active"/>

        </tree>

    </field>
</record>


<record id="equipment_item_kanban_view" model="ir.ui.view">
    <field name="name">equipment.item.kanban</field>
    <field name="model">equipment.item</field>
    <field name="arch" type="xml">

        <kanban>

            <field name="name"/>
            <field name="code"/>
            <field name="category_id"/>
            <field name="daily_rate"/>
            <field name="condition_score"/>
            <field name="state"/>
            <field name="image_1920"/>

            <templates>
                <t t-name="kanban-box">

                    <div class="oe_kanban_global_click">

                        <div class="mb-2">
                            <img
                                t-att-src="kanban_image(
                                    'equipment.item',
                                    'image_1920',
                                    record.id.raw_value
                                )"
                                class="img-fluid"
                                style="width: 100%; height: 180px; object-fit: cover;"
                            />
                        </div>

                        <strong>
                            <field name="name"/>
                        </strong>

                        <div>
                            <field name="code"/>
                        </div>

                        <div>
                            <field name="category_id"/>
                        </div>

                        <div>
                            <strong>Rate:</strong>
                            <field name="daily_rate"/>
                        </div>

                        <div>
                            <strong>Condition:</strong>
                            <field name="condition_score"/>
                        </div>

                        <div>
                            <strong>Status:</strong>
                            <field name="state"/>
                        </div>

                    </div>

                </t>
            </templates>

        </kanban>

    </field>
</record>


<record id="equipment_item_form_view" model="ir.ui.view">
    <field name="name">equipment.item.form</field>
    <field name="model">equipment.item</field>
    <field name="arch" type="xml">

        <form>

            <sheet>

                <div class="oe_button_box" name="button_box">

                    <button
                        name="action_view_loans"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list"
                    >
                        <field
                            name="loan_count"
                            widget="statinfo"
                            string="Loans"
                        />
                    </button>

                </div>



                <group>

                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="daily_rate"/>
                        <field name="currency_id"/>
                    </group>

                    <group>
                        <field name="condition_score"  widget="condition_gauge" options="{'segments': 10}"/>
                        <field name="state"/>
                        <field name="active"/>
                        <field name="loan_count"/>
                        <field name="total_days_on_loan"/>

                    </group>

                </group>

                <group>
                    <field name="image_1920" widget="image"/>
                </group>

            </sheet>

        </form>

    </field>
</record>


    <record id="action_equipment_item" model="ir.actions.act_window">
    <field name="name">Equipment Items</field>
    <field name="res_model">equipment.item</field>
    <field name="view_mode">kanban,tree,form</field>
    </record>




</odoo>