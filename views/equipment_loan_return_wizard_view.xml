<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="equipment_loan_return_wizard_form" model="ir.ui.view">
        <field name="name">equipment.loan.return.wizard.form</field>
        <field name="model">equipment.loan.return.wizard</field>
        <field name="arch" type="xml">

            <form string="Return Equipment">

                <group>
                    <field name="loan_ids" widget="many2many_tags" readonly="1"/>
                    <field name="date_return"/>
                    <field name="condition_score"/>
                    <field name="note"/>
                </group>

                <footer>
                    <button name="action_confirm"
                            type="object"
                            string="Confirm Return"
                            class="btn-primary"/>

                    <button string="Cancel"
                            special="cancel"/>
                </footer>

            </form>

        </field>
    </record>


    <record id="action_equipment_loan_return_wizard"
        model="ir.actions.server">

    <field name="name">Return Equipment</field>

    <field name="model_id" ref="model_equipment_loan"/>

    <field name="binding_model_id"
           ref="model_equipment_loan"/>

    <field name="binding_view_types">list</field>

    <field name="state">code</field>

    <field name="code">
action = records.action_open_return_wizard()
    </field>

</record>

</odoo>